# ---- Database (Postgres) ----
# Local Docker (see docker-compose.yml) uses port 5433.
DATABASE_URL="postgresql://jr:jr_secret@localhost:5433/jr_interiors?schema=public"

# ---- Auth ----
# REQUIRED in production. Generate: openssl rand -base64 32
AUTH_SECRET="change-this-to-a-long-random-string"

# ---- Public site URL (used for SEO, sitemap, canonical, OG) ----
NEXT_PUBLIC_SITE_URL="https://www.jrinteriors.in"

# ---- Razorpay (test or live) ----
# Get keys from https://dashboard.razorpay.com/app/keys
# Leave blank to disable online payment (Cash on Delivery still works).
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# ---- Admin ----
# This account can view all orders at /admin/orders.
ADMIN_EMAIL="owner@yourdomain.in"
