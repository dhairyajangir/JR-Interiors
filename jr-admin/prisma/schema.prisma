// JR Admin standalone service. Prices stored in whole INR.
generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
  output          = "../node_modules/@prisma/client-admin"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["jr_admin", "public"]
}

model User {
  id           String                @id @default(cuid())
  fullName     String
  businessName String
  email        String                @unique
  phone        String?
  passwordHash String
  status       UserStatus            @default(TRIAL)
  lastLoginAt  DateTime?
  loginCount   Int                   @default(0)
  isDemo       Boolean               @default(false)
  isAdmin      Boolean               @default(false)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  twoFactorSecret String?
  twoFactorEnabled Boolean           @default(false)
  products     Product[]
  payments     RegistrationPayment[]
  auditLogs    AuditLog[]

  @@index([status])
  @@schema("jr_admin")
}

model RegistrationPayment {
  id         String        @id @default(cuid())
  reference  String        @unique
  planName   String
  amountInr  Int
  note       String
  payeeVpa   String
  payeeName  String
  upiLink    String
  status     PaymentStatus @default(PENDING)
  screenshot String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  userId     String
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@schema("jr_admin")
}

model Product {
  id               String        @id @default(cuid())
  title            String
  slug             String        @unique
  sku              String        @unique
  category         String
  priceInr         Int
  inventory        Int           @default(0)
  status           ProductStatus @default(LIVE)
  shortDescription String
  coverImage       String
  gallery          String[]      @default([])
  featured         Boolean       @default(false)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  ownerId          String
  owner            User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, createdAt])
  @@index([status])
  @@index([category])
  @@schema("jr_admin")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String
  entity    String?
  entityId  String?
  details   String?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([action])
  @@index([createdAt])
  @@schema("jr_admin")
}

model StorefrontUser {
  id            String                   @id
  email         String                   @unique
  passwordHash  String
  fullName      String
  phone         String?
  role          String
  createdAt     DateTime
  orders        StorefrontOrder[]
  seller        StorefrontSeller?
  consultations StorefrontConsultation[]

  @@index([role])
  @@map("User")
  @@schema("public")
}

model StorefrontSeller {
  id        String             @id
  userId    String             @unique
  user      StorefrontUser     @relation(fields: [userId], references: [id], onDelete: Cascade)
  brandName String
  slug      String             @unique
  bio       String?
  logoUrl   String?
  status    String
  createdAt DateTime
  products  StorefrontProduct[]

  @@map("Seller")
  @@schema("public")
}

model StorefrontProduct {
  id          String               @id
  slug        String               @unique
  name        String
  tagline     String?
  series      String?
  description String
  priceCents  Int
  material    String
  room        String
  type        String
  imageUrl    String
  images      String[]
  finishes    Json
  upholstery  String[]
  colorHexes  String[]
  rating      Float
  reviewCount Int
  featured    Boolean
  signature   Boolean
  inStock     Boolean
  stock       Int
  status      String
  reviewNote  String?
  createdAt   DateTime
  sellerId    String?
  seller      StorefrontSeller?    @relation(fields: [sellerId], references: [id])
  categoryId  String?
  orderItems  StorefrontOrderItem[]

  @@index([status])
  @@index([sellerId])
  @@map("Product")
  @@schema("public")
}

model StorefrontOrder {
  id                String               @id
  number            String               @unique
  email             String
  fullName          String
  phone             String?
  address1          String
  address2          String?
  city              String
  region            String
  postalCode        String
  country           String
  shippingType      String
  subtotalCents     Int
  shippingCents     Int
  taxCents          Int
  totalCents        Int
  status            String
  paymentMethod     String
  paymentStatus     String
  razorpayOrderId   String?
  razorpayPaymentId String?
  createdAt         DateTime
  userId            String?
  user              StorefrontUser?      @relation(fields: [userId], references: [id])
  items             StorefrontOrderItem[]

  @@index([createdAt])
  @@index([status])
  @@index([paymentStatus])
  @@map("Order")
  @@schema("public")
}

model StorefrontOrderItem {
  id         String             @id
  orderId    String
  order      StorefrontOrder    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId  String?
  product    StorefrontProduct? @relation(fields: [productId], references: [id])
  name       String
  priceCents Int
  quantity   Int
  finish     String?
  upholstery String?
  imageUrl   String?
  sellerId   String?
  itemStatus String

  @@index([orderId])
  @@index([sellerId])
  @@map("OrderItem")
  @@schema("public")
}

model StorefrontConsultation {
  id          String          @id
  userId      String?
  user        StorefrontUser? @relation(fields: [userId], references: [id], onDelete: SetNull)
  name        String
  email       String
  phone       String?
  projectType String
  message     String?
  status      String
  createdAt   DateTime
  updatedAt   DateTime

  @@index([status, createdAt])
  @@map("Consultation")
  @@schema("public")
}

enum UserStatus {
  TRIAL
  PENDING_REVIEW
  ACTIVE
  SUSPENDED

  @@schema("jr_admin")
}

enum PaymentStatus {
  PENDING
  REPORTED
  CONFIRMED

  @@schema("jr_admin")
}

enum ProductStatus {
  DRAFT
  LIVE
  ARCHIVED

  @@schema("jr_admin")
}
