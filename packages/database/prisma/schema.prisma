// JR Interiors — data model. Prices stored as integer cents.
generator client {
  provider = "prisma-client-js"
  output   = "../../../node_modules/@prisma/client-storefront"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  supabaseId    String?        @unique
  passwordHash  String
  fullName      String
  phone         String?
  role          String         @default("CUSTOMER") // "CUSTOMER" | "SELLER" | "ADMIN"
  createdAt     DateTime       @default(now())
  addresses     Address[]
  consultations Consultation[]
  orders        Order[]
  seller        Seller?
  wishlistItems WishlistItem[]
  auditLogs     AuditLog[]

  @@index([role])
}

model Seller {
  id        String    @id @default(cuid())
  userId    String    @unique
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  brandName String
  slug      String    @unique
  bio       String?
  logoUrl   String?
  status    String    @default("active") // "active" | "suspended"
  createdAt DateTime  @default(now())
  products  Product[]
}

model Address {
  id         String  @id @default(cuid())
  userId     String
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  label      String  @default("Home")
  fullName   String
  line1      String
  line2      String?
  city       String
  region     String
  postalCode String
  country    String  @default("India")
  phone      String?
  isDefault  Boolean @default(false)

  @@index([userId])
}

model Category {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  kind        String    @default("room") // "room" | "collection" | "type"
  description String?
  imageUrl    String?
  itemCount   Int       @default(0)
  sortOrder   Int       @default(0)
  products    Product[]

  @@index([kind])
}

model Product {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  tagline     String? // e.g. "Walnut / Linen"
  series      String? // e.g. "Artisanal Living Series"
  description String
  priceCents  Int
  material    String
  room        String // "Living" | "Office" | "Dining" | "Bedroom" | "Studio"
  type        String // "Seating" | "Tables" | "Storage" | "Bedroom" | "Lighting" | "Decor"
  imageUrl    String
  images      String[] @default([])
  finishes    Json     @default("[]") // [{ name, hex }]
  upholstery  String[] @default([])
  colorHexes  String[] @default([])
  rating      Float    @default(0)
  reviewCount Int      @default(0)
  featured    Boolean  @default(false)
  signature   Boolean  @default(false)
  inStock     Boolean  @default(true)
  stock       Int      @default(0)
  status      String   @default("PUBLISHED") // "DRAFT" | "PENDING" | "PUBLISHED" | "REJECTED"
  reviewNote  String? // admin rejection reason
  createdAt   DateTime @default(now())

  sellerId      String?
  seller        Seller?        @relation(fields: [sellerId], references: [id])
  categoryId    String?
  category      Category?      @relation(fields: [categoryId], references: [id])
  cartItems     CartItem[]
  orderItems    OrderItem[]
  reviews       Review[]
  wishlistItems WishlistItem[]

  @@index([room])
  @@index([type])
  @@index([featured])
  @@index([signature])
  @@index([room, type]) // combined catalog filter
  @@index([material])
  @@index([createdAt]) // default "newest" sort
  @@index([priceCents]) // price sort
  @@index([reviewCount]) // "most popular" sort
  @@index([status]) // storefront publish filter + moderation queue
  @@index([sellerId]) // seller dashboard
  @@index([status, createdAt]) // published catalog ordered by newest
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId, createdAt])
  @@index([productId])
}

model Review {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  author    String
  initials  String
  rating    Int
  body      String
  createdAt DateTime @default(now())

  @@index([productId])
}

model Cart {
  id        String     @id @default(cuid())
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id         String  @id @default(cuid())
  cartId     String
  cart       Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId  String
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity   Int     @default(1)
  finish     String?
  upholstery String?

  @@index([cartId])
}

model Order {
  id                String      @id @default(cuid())
  number            String      @unique
  email             String
  fullName          String
  phone             String?
  address1          String
  address2          String?
  city              String
  region            String
  postalCode        String
  country           String      @default("India")
  shippingType      String      @default("standard")
  subtotalCents     Int
  shippingCents     Int
  taxCents          Int // GST amount (paise)
  totalCents        Int
  status            String      @default("confirmed")
  paymentMethod     String      @default("cod") // "cod" | "razorpay"
  paymentStatus     String      @default("pending") // "pending" | "paid" | "failed"
  razorpayOrderId   String?
  razorpayPaymentId String?
  createdAt         DateTime    @default(now())
  userId            String?
  user              User?       @relation(fields: [userId], references: [id])
  items             OrderItem[]

  @@index([userId])
  @@index([createdAt]) // order history + admin list (newest first)
  @@index([email])
  @@index([paymentStatus])
}

model OrderItem {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId  String?
  product    Product? @relation(fields: [productId], references: [id])
  name       String
  priceCents Int
  quantity   Int
  finish     String?
  upholstery String?
  imageUrl   String?
  sellerId   String? // snapshot of the product's seller at order time
  itemStatus String   @default("pending") // "pending" | "fulfilled"

  @@index([orderId])
  @@index([sellerId])
}

model Consultation {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  name        String
  email       String
  phone       String?
  projectType String
  message     String?
  status      String   @default("NEW") // "NEW" | "CONTACTED" | "SCHEDULED" | "COMPLETED"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([status, createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?  // Nullable — pre-auth events (e.g. LOGIN_FAILED) may not have a resolved userId
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String
  entity    String?
  entityId  String?
  details   String?  // JSON-serialized metadata
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([action])
  @@index([createdAt])
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

